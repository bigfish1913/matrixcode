#!/bin/sh
#
# Pre-commit hook for MatrixCode
# 本地代码门禁 - 提交前自动检查
#

set -e

echo "Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FAILED=0

# 1. Check Rust formatting
echo ""
echo "1. Checking Rust formatting..."
cd packages/cli
if cargo fmt --all -- --check 2>/dev/null; then
    echo "${GREEN}✓ Rust formatting OK${NC}"
else
    echo "${RED}✗ Rust formatting failed${NC}"
    echo "   Run: cargo fmt --all"
    FAILED=1
fi

# 2. Run Clippy
echo ""
echo "2. Running Clippy..."
if cargo clippy --all-targets --all-features -- -D warnings 2>/dev/null; then
    echo "${GREEN}✓ Clippy OK${NC}"
else
    echo "${RED}✗ Clippy warnings found${NC}"
    echo "   Run: cargo clippy --all-targets --all-features -- -D warnings"
    FAILED=1
fi

# 3. Run tests
echo ""
echo "3. Running Rust tests..."
if cargo test 2>&1 | grep -q "test result: ok"; then
    echo "${GREEN}✓ Tests passed${NC}"
else
    echo "${RED}✗ Tests failed${NC}"
    FAILED=1
fi

cd ../..

# 4. Check version consistency (if Cargo.toml modified)
echo ""
echo "4. Checking version consistency..."
if git diff --cached --name-only | grep -q "Cargo.toml"; then
    ROOT_VERSION=$(grep "^version = " Cargo.toml | head -1 | sed 's/version = "\(.*\)"/\1/')
    CLI_VERSION=$(grep "^version = " packages/cli/Cargo.toml | head -1 | sed 's/version = "\(.*\)"/\1/')
    CORE_VERSION=$(grep "^version = " packages/core/Cargo.toml | head -1 | sed 's/version = "\(.*\)"/\1/')
    TUI_VERSION=$(grep "^version = " packages/tui/Cargo.toml | head -1 | sed 's/version = "\(.*\)"/\1/')

    if [ "$ROOT_VERSION" = "$CLI_VERSION" ] && [ "$CLI_VERSION" = "$CORE_VERSION" ] && [ "$CORE_VERSION" = "$TUI_VERSION" ]; then
        echo "${GREEN}✓ Versions consistent: $ROOT_VERSION${NC}"
    else
        echo "${RED}✗ Version mismatch!${NC}"
        echo "   Root: $ROOT_VERSION"
        echo "   CLI: $CLI_VERSION"
        echo "   Core: $CORE_VERSION"
        echo "   TUI: $TUI_VERSION"
        echo "   Run: task bump-auto"
        FAILED=1
    fi
else
    echo "${YELLOW}⊘ Skipped (Cargo.toml not modified)${NC}"
fi

# 5. Check CHANGELOG updated (if version bumped)
echo ""
echo "5. Checking CHANGELOG..."
if git diff --cached --name-only | grep -q "Cargo.toml"; then
    if git diff --cached --name-only | grep -q "CHANGELOG.md"; then
        echo "${GREEN}✓ CHANGELOG updated${NC}"
    else
        echo "${YELLOW}⚠ WARNING: Version bumped but CHANGELOG not updated${NC}"
        echo "   Consider updating CHANGELOG.md"
    fi
else
    echo "${YELLOW}⊘ Skipped (version not bumped)${NC}"
fi

# 6. Check for large files (>1MB)
echo ""
echo "6. Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only --diff-filter=A | while read f; do
    if [ -f "$f" ]; then
        SIZE=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt 1048576 ]; then
            echo "$f ($(echo $SIZE / 1048576 | bc)MB)"
        fi
    fi
done)

if [ -z "$LARGE_FILES" ]; then
    echo "${GREEN}✓ No large files${NC}"
else
    echo "${RED}✗ Large files detected:${NC}"
    echo "$LARGE_FILES"
    FAILED=1
fi

# 7. Check for session files accidentally staged
echo ""
echo "7. Checking for session files..."
SESSION_FILES=$(git diff --cached --name-only | grep -E "\.matrix/sessions|sessions/.*\.json$" || true)
if [ -z "$SESSION_FILES" ]; then
    echo "${GREEN}✓ No session files staged${NC}"
else
    echo "${RED}✗ Session files should not be committed:${NC}"
    echo "$SESSION_FILES"
    echo "   Run: git reset HEAD $SESSION_FILES"
    FAILED=1
fi

# 8. Check for TODO/FIXME in code
echo ""
echo "8. Checking for TODO/FIXME comments..."
TODO_COUNT=$(git diff --cached --name-only | grep '\.rs$' | xargs grep -h "TODO\|FIXME" 2>/dev/null | wc -l)
if [ "$TODO_COUNT" -lt 5 ]; then
    echo "${GREEN}✓ TODO count acceptable ($TODO_COUNT)${NC}"
else
    echo "${YELLOW}⚠ $TODO_COUNT TODO/FIXME comments found${NC}"
fi

# Summary
echo ""
echo "========================================"
if [ $FAILED -eq 0 ]; then
    echo "${GREEN}✓ All checks passed!${NC}"
    echo "========================================"
    exit 0
else
    echo "${RED}✗ Some checks failed${NC}"
    echo "========================================"
    exit 1
fi