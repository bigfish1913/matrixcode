{
  "name": "matrixcode-monorepo",
  "version": "0.4.44",
  "private": true,
  "description": "MatrixCode - AI-powered code agent toolkit",
  "workspaces": [
    "packages/gui",
    "packages/vscode"
  ],
  "scripts": {
    "tauri:dev": "npm run tauri:dev -w packages/gui",
    "tauri:build": "npm run tauri:build -w packages/gui",
