{
  "name": "matrixcode",
  "displayName": "MatrixCode - AI Code Agent",
  "description": "Intelligent code agent with multi-model support, context compression, and cross-session memory",
  "version": "0.1.0",
  "publisher": "bigfish1913",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigfish1913/matrixcode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "code assistant",
    "llm",
    "anthropic",
    "claude",
    "openai",
    "gpt"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "matrixcode",
          "title": "MatrixCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "matrixcode": [
        {
          "type": "webview",
          "id": "matrixcode.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "matrixcode.explain",
        "title": "MatrixCode: Explain Code",
        "icon": "$(info)"
      },
      {
        "command": "matrixcode.fix",
        "title": "MatrixCode: Fix Code",
        "icon": "$(wrench)"
      },
      {
        "command": "matrixcode.generateTests",
        "title": "MatrixCode: Generate Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "matrixcode.refactor",
        "title": "MatrixCode: Refactor Selection",
        "icon": "$(symbol-refactor)"
      },
      {
        "command": "matrixcode.newSession",
        "title": "MatrixCode: New Session",
        "icon": "$(add)"
      },
      {
        "command": "matrixcode.showHistory",
        "title": "MatrixCode: Show Session History",
        "icon": "$(history)"
      },
      {
        "command": "matrixcode.openSettings",
        "title": "MatrixCode: Open Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "matrixcode.submenu",
          "group": "matrixcode@0"
        }
      ],
      "matrixcode.submenu": [
        {
          "command": "matrixcode.explain",
          "when": "editorHasSelection",
          "group": "1_actions@1"
        },
        {
          "command": "matrixcode.fix",
          "when": "editorHasSelection",
          "group": "1_actions@2"
        },
        {
          "command": "matrixcode.refactor",
          "when": "editorHasSelection",
          "group": "1_actions@3"
        },
        {
          "command": "matrixcode.generateTests",
          "when": "editorHasSelection",
          "group": "2_generate@1"
        }
      ],
      "view/title": [
        {
          "command": "matrixcode.newSession",
          "when": "view == matrixcode.chat",
          "group": "navigation@1"
        },
        {
          "command": "matrixcode.showHistory",
          "when": "view == matrixcode.chat",
          "group": "navigation@2"
        },
        {
          "command": "matrixcode.openSettings",
          "when": "view == matrixcode.chat",
          "group": "navigation@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "matrixcode.submenu",
        "label": "MatrixCode"
      }
    ],
    "configuration": {
      "title": "MatrixCode",
      "properties": {
        "matrixcode.cliPath": {
          "type": "string",
          "default": "matrixcode",
          "description": "Path to the MatrixCode CLI binary. Use 'matrixcode' if it's in PATH, or provide the full path."
        },
        "matrixcode.provider": {
          "type": "string",
          "enum": ["anthropic", "openai"],
          "enumDescriptions": [
            "Anthropic Claude models",
            "OpenAI GPT models"
          ],
          "default": "anthropic",
          "description": "LLM provider to use"
        },
        "matrixcode.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "markdownDescription": "Model name. Examples:\n- Anthropic: `claude-sonnet-4-20250514`, `claude-opus-4-20250514`, `claude-3-5-haiku-20241022`\n- OpenAI: `gpt-4o`, `gpt-4-turbo`, `gpt-3.5-turbo`"
        },
        "matrixcode.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "Automatically include current file and selection as context"
        },
        "matrixcode.think": {
          "type": "boolean",
          "default": true,
          "description": "Enable extended thinking mode (Anthropic only)"
        },
        "matrixcode.markdown": {
          "type": "boolean",
          "default": true,
          "description": "Render responses as Markdown"
        },
        "matrixcode.maxTokens": {
          "type": "number",
          "default": 16384,
          "description": "Maximum output tokens per response"
        },
        "matrixcode.compressModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for context compression. Leave empty to use the main model. Recommended: `claude-3-5-haiku-20241022`"
        },
        "matrixcode.daemonMode": {
          "type": "boolean",
          "default": true,
          "description": "Use daemon mode for persistent CLI process (recommended)"
        },
        "matrixcode.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show thinking process in chat view"
        },
        "matrixcode.showToolUse": {
          "type": "boolean",
          "default": true,
          "description": "Show tool usage (file reads, bash commands, etc.) in chat view"
        }
      }
    },
    "keybindings": [
      {
        "command": "matrixcode.explain",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "matrixcode.fix",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "compile-dev": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}