# MatrixCode Environment Variables
# Copy this file to .env or .matrix/.env

# Enable debug logging (1, true, or verbose)
# Default: true for development builds, should be false in production
MATRIXCODE_DEBUG=true

# API Configuration (also read from ~/.matrix/config.json or ~/.claude/settings.json)
ANTHROPIC_AUTH_TOKEN=your-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Alternative model configuration
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-20250514
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-3-5-haiku-20241022

# Image Search API Keys (optional - for image_search tool)
# Get keys from: https://unsplash.com/developers, https://www.pexels.com/api/, https://pixabay.com/api/docs/
UNSPLASH_ACCESS_KEY=your-unsplash-key
PEXELS_API_KEY=your-pexels-key
PIXABAY_API_KEY=your-pixabay-key
